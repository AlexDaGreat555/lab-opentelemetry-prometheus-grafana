#!/usr/bin/env bash

set -euo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if [[ "${LAB05_STACK_READY:-}" != "1" ]]; then
  docker compose up --detach --build --wait
fi

resolve_request_host() {
  if curl --noproxy '*' --fail --silent --max-time 0.5 \
    http://127.0.0.1:3000/health >/dev/null 2>&1; then
    printf '127.0.0.1'
  elif getent hosts host.docker.internal >/dev/null 2>&1 && \
    curl --noproxy '*' --fail --silent --max-time 0.5 \
      http://host.docker.internal:3000/health >/dev/null 2>&1; then
    printf 'host.docker.internal'
  else
    return 1
  fi
}

request_host=$(resolve_request_host) || {
  printf 'FAIL: the lab app is not reachable; run ./scripts/start-lab first.\n' >&2
  exit 1
}
app_url="http://${request_host}:3000"
prometheus_url="http://${request_host}:9090"
profile=${1:-baseline}

case "$profile" in
  baseline)
    successful_requests=8
    not_found_requests=2
    ;;
  degraded)
    successful_requests=2
    not_found_requests=8
    ;;
  *)
    printf 'Usage: %s [baseline|degraded]\n' "$0" >&2
    exit 2
    ;;
esac

send_burst() {
  local request_number

  for ((request_number = 1; request_number <= successful_requests; request_number++)); do
    curl --noproxy '*' --fail --silent --show-error \
      --output /dev/null "${app_url}/work"
  done

  for ((request_number = 1; request_number <= not_found_requests; request_number++)); do
    suffix="missing-${profile}-${request_number}"
    status=$(curl --noproxy '*' --silent --show-error \
      --output /dev/null --write-out '%{http_code}' "${app_url}/${suffix}")
    if [[ "$status" != "404" ]]; then
      printf 'FAIL: expected /%s to return 404, got %s.\n' "$suffix" "$status" >&2
      return 1
    fi
  done
}

sample_counter() {
  curl --noproxy '*' --fail --silent --get \
    --data-urlencode 'query=lab05_requests_total{method="GET",status="404"}' \
    "${prometheus_url}/api/v1/query" | node -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => input += chunk);
      process.stdin.on("end", () => {
        try {
          const payload = JSON.parse(input);
          const sample = payload.data?.result?.[0]?.value;
          if (payload.status === "success" && Array.isArray(sample)) {
            process.stdout.write(`${sample[0]} ${sample[1]}`);
          }
        } catch {}
      });
    '
}

wait_for_sample() {
  local earlier_timestamp=$1
  local earlier_value=$2
  local deadline=$((SECONDS + 20))

  while ((SECONDS < deadline)); do
    sample=$(sample_counter || true)
    read -r timestamp value <<< "$sample"
    if [[ -n "${timestamp:-}" && -n "${value:-}" ]] && \
      node -e 'process.exit(Number(process.argv[1]) > Number(process.argv[2]) && Number(process.argv[3]) > Number(process.argv[4]) ? 0 : 1)' \
        "$timestamp" "$earlier_timestamp" "$value" "$earlier_value"; then
      printf '%s %s\n' "$timestamp" "$value"
      return 0
    fi
    sleep 0.5
  done

  return 1
}

# Record the latest stored sample before sending traffic. This prevents a prior
# run's sample from being mistaken for the next scrape after an app rebuild.
baseline_sample=$(sample_counter || true)
read -r baseline_timestamp _baseline_value <<< "$baseline_sample"
baseline_timestamp=${baseline_timestamp:-0}

# Two fixed 8:2 bursts separated by Prometheus scrapes guarantee that rate()
# has at least two samples and observes a positive change.
send_burst
if ! read -r first_timestamp first_value < <(
  wait_for_sample "$baseline_timestamp" -1
); then
  printf 'FAIL: Prometheus did not scrape the generated metrics within 20 seconds.\n' >&2
  exit 1
fi

send_burst
if ! read -r _second_timestamp _second_value < <(
  wait_for_sample "$first_timestamp" "$first_value"
); then
  printf 'FAIL: Prometheus did not observe the second traffic burst within 20 seconds.\n' >&2
  exit 1
fi

printf 'Generated the %s profile: %d successful and %d not-found GET requests.\n' \
  "$profile" "$((successful_requests * 2))" "$((not_found_requests * 2))"
printf 'Prometheus observed both traffic bursts.\n'
