#!/usr/bin/env bash

set -uo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root" || exit 1

failures=0
stack_attempted=false
temporary_directory=$(mktemp -d)

cleanup() {
  if [[ "$stack_attempted" == true ]]; then
    docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
  rm --recursive --force -- "$temporary_directory"
}
trap cleanup EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

for command in curl docker node; do
  if ! command -v "$command" >/dev/null 2>&1; then
    record_failure "$command is not available; reopen this repository in its devcontainer"
  fi
done

if ! docker compose version >/dev/null 2>&1; then
  record_failure "Docker Compose is not available; reopen this repository in its devcontainer"
fi

query_path="lab05/success-ratio.promql"
expression=""
if [[ ! -f "$query_path" ]]; then
  record_failure "$query_path is missing"
else
  expression=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$query_path")
  if [[ -z "$expression" ]]; then
    record_failure "$query_path does not yet contain a PromQL expression"
  fi
fi

if ((failures > 0)); then
  printf '\nLab check stopped before starting the stack.\n' >&2
  exit 1
fi

stack_attempted=true
docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true

printf '\nStarting the pinned lab stack...\n'
if ! docker compose up --detach --build --wait app prometheus; then
  record_failure "the app and Prometheus did not become healthy"
fi

resolve_request_host() {
  if curl --noproxy '*' --fail --silent --max-time 0.5 \
    http://127.0.0.1:3000/health >/dev/null 2>&1; then
    printf '127.0.0.1'
  elif getent hosts host.docker.internal >/dev/null 2>&1 && \
    curl --noproxy '*' --fail --silent --max-time 0.5 \
      http://host.docker.internal:3000/health >/dev/null 2>&1; then
    printf 'host.docker.internal'
  else
    return 1
  fi
}

request_host=$(resolve_request_host || true)
if [[ -z "$request_host" ]]; then
  record_failure "the running app is not reachable from the devcontainer"
fi

query_signal() {
  local label=$1
  local response_path="$temporary_directory/${label}.json"

  if ! curl --noproxy '*' --fail --silent --show-error --get \
    --data-urlencode "query=${expression}" \
    "http://${request_host}:9090/api/v1/query" > "$response_path"; then
    return 1
  fi

  node - "$response_path" <<'NODE'
"use strict";

const fs = require("node:fs");

try {
  const payload = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
  if (payload.status !== "success") {
    throw new Error(payload.error || "Prometheus rejected the expression");
  }

  let samples;
  if (payload.data?.resultType === "scalar") {
    samples = [payload.data.result];
  } else if (payload.data?.resultType === "vector") {
    samples = (payload.data.result || []).map(result => result.value);
  } else {
    throw new Error("the expression must return an instant scalar or vector");
  }

  if (samples.length !== 1 || !Array.isArray(samples[0])) {
    throw new Error("the expression must return exactly one value");
  }

  const value = Number(samples[0][1]);
  if (!Number.isFinite(value)) {
    throw new Error("the expression returned a non-finite value");
  }
  process.stdout.write(String(value));
} catch (error) {
  console.error(error.message);
  process.exit(1);
}
NODE
}

baseline_value=""
degraded_value=""

if ((failures == 0)); then
  if ! LAB05_STACK_READY=1 ./scripts/generate-traffic baseline; then
    record_failure "the baseline traffic profile did not complete"
  elif ! baseline_value=$(query_signal baseline); then
    record_failure "the expression did not return one numeric result for baseline traffic"
  elif ! node -e '
    const value = Number(process.argv[1]);
    process.exit(value >= 0.65 && value <= 0.95 ? 0 : 1);
  ' "$baseline_value"; then
    record_failure "the baseline result was not a plausible fraction of successful requests"
  else
    printf 'Baseline signal: %s\n' "$baseline_value"
  fi
fi

if ((failures == 0)); then
  if ! LAB05_STACK_READY=1 ./scripts/generate-traffic degraded; then
    record_failure "the degraded traffic profile did not complete"
  elif ! degraded_value=$(query_signal degraded); then
    record_failure "the expression did not return one numeric result for degraded traffic"
  elif ! node -e '
    const baseline = Number(process.argv[1]);
    const degraded = Number(process.argv[2]);
    process.exit(
      degraded >= 0 && degraded <= 1 && degraded <= baseline - 0.10 ? 0 : 1,
    );
  ' "$baseline_value" "$degraded_value"; then
    record_failure "the signal did not decrease when the traffic profile degraded"
  else
    printf 'Degraded signal: %s\n' "$degraded_value"
  fi
fi

if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 5 checks passed.\n'
